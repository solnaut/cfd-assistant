{
  "name": "cfd-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "Independent open-source CFD calculation, thermal-fluid learning, and Ansys Fluent interactive teaching workbench.",
  "license": "MIT",
  "homepage": "https://solnaut.github.io/cfd-assistant/",
  "repository": {
    "type": "git",
    "url": "https://github.com/solnaut/cfd-assistant.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "deploy:pages": "node scripts/deploy-gh-pages.mjs"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
