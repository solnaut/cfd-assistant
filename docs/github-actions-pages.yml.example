# GitHub Actions workflow template for automatic GitHub Pages deployment.
# Because standard `gh` CLI tokens may omit the `workflow` OAuth scope, copy this file to:
#   .github/workflows/deploy-pages.yml
# after running `gh auth refresh -s workflow` (or create it directly in GitHub Web UI).

name: Deploy CFD Assistant to GitHub Pages

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build-and-verify:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Lint, test, and build for GitHub Pages
        env:
          VITE_BASE_PATH: /cfd-assistant/
        run: |
          npm run lint
          npm run test
          npm run build

      - name: Add SPA fallback and disable Jekyll
        run: |
          touch dist/.nojekyll
          cat << 'EOF' > dist/404.html
          <!doctype html>
          <html lang="zh-CN">
            <head>
              <meta charset="UTF-8" />
              <title>CFD Assistant</title>
              <script>
                ;(function () {
                  var target = window.location.pathname + window.location.search + window.location.hash
                  try {
                    window.sessionStorage.setItem('cfd-assistant:spa-redirect', target)
                  } catch {}
                  window.location.replace('/cfd-assistant/')
                })()
              </script>
            </head>
            <body></body>
          </html>
          EOF

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build-and-verify
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
